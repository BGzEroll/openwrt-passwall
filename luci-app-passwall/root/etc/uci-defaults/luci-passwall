#!/bin/sh

if [ ! -s /etc/config/passwall ]; then
	[ -s /usr/share/passwall/0_default_config ] || exit 1
	cp /usr/share/passwall/0_default_config /etc/config/passwall || exit 1
fi

if ! uci -q get 'ucitrack.@passwall[0]' >/dev/null 2>&1; then
	uci -q add ucitrack passwall >/dev/null || exit 1
fi

uci -q batch <<'EOF' || exit 1
set ucitrack.@passwall[0].init=passwall
set dhcp.@dnsmasq[0].localuse=1
set firewall.passwall=include
set firewall.passwall.type=script
set firewall.passwall.path=/var/etc/passwall.include
set firewall.passwall.fw4_compatible=1
commit ucitrack
commit dhcp
commit firewall
EOF

rm -f /tmp/luci-indexcache*
rm -rf /tmp/luci-modulecache/
killall -HUP rpcd 2>/dev/null

exit 0
