#!/bin/sh

uci -q batch <<-EOF >/dev/null
	set dhcp.@dnsmasq[0].localuse=1
	commit dhcp
	[ -e "/etc/config/ucitrack" ] && {
	delete ucitrack.@passwall[-1]
	add ucitrack passwall
	set ucitrack.@passwall[-1].init=passwall
	commit ucitrack
	}
	delete firewall.passwall
	set firewall.passwall=include
	set firewall.passwall.type=script
	set firewall.passwall.path=/var/etc/passwall.include
	commit firewall
	set uhttpd.main.max_requests=50
	commit uhttpd
EOF

[ ! -s "/etc/config/passwall" ] && cp -f /usr/share/passwall/0_default_config /etc/config/passwall

# Discard settings for features removed from this personal build; retain nodes.
for type in global_app global_subscribe subscribe_list; do
	while uci -q delete "passwall.@$type[0]"; do :; done
done
uci -q delete 'passwall.@global_delay[0].start_daemon'
for option in geoip_update geosite_update v2ray_location_asset interval_update; do
	uci -q delete "passwall.@global_rules[0].$option"
done
for option in geoip_path geoip_url geosite_path geosite_url; do
	uci -q delete "passwall.@global_singbox[0].$option"
done
if [ "$(uci -q get 'passwall.@global_rules[0].week_update')" = 8 ]; then
	uci set 'passwall.@global_rules[0].auto_update=0'
	uci -q delete 'passwall.@global_rules[0].week_update'
fi
for node in $(uci -q show passwall | sed -n 's/^passwall\.\([^.=]*\)=nodes$/\1/p'); do
	uci -q delete "passwall.$node.add_mode"
	uci -q delete "passwall.$node.add_from"
done
uci commit passwall

chmod +x /usr/share/passwall/*.sh

rm -f /tmp/luci-indexcache*
rm -rf /tmp/luci-modulecache/
killall -HUP rpcd 2>/dev/null

exit 0
