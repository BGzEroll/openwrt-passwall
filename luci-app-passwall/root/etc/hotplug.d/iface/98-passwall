#!/bin/sh

# Personal topology: WAN, main LAN and the external proxy VLAN only.
case "$INTERFACE" in wan|wan6|lan|localproxy) ;; *) exit 0 ;; esac
case "$ACTION" in ifup|ifdown|ifupdate) ;; *) exit 0 ;; esac
[ -f /var/run/passwall/running ] || exit 0

# Queue behind the same service lock. Each waiter reads fresh state and skips
# duplicate notifications; stop removes running before any queued work executes.
(
	sleep 1
	/etc/init.d/passwall reload network
) >/dev/null 2>&1 &
