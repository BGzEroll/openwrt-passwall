#!/bin/sh /etc/rc.common

START=99
STOP=15
EXTRA_COMMANDS="update_rules"
EXTRA_HELP="        update_rules <directory>  Publish downloaded text rules and apply them"

APP_FILE=/usr/share/passwall/app.sh
LOCK_FILE=/var/lock/passwall.lock

run_service() {
	mkdir -p /var/lock
	(
		flock -x 9 || exit 1
		"$APP_FILE" "$@"
	) 9>"$LOCK_FILE"
}

boot() {
	(
		local delay=$(uci -q get 'passwall.@global_delay[0].start_delay')
		[ "${delay:-0}" -le 0 ] || sleep "$delay"
		start
	) >/dev/null 2>&1 &
}

start() {
	run_service start
}

stop() {
	run_service stop
}

restart() {
	mkdir -p /var/lock
	(
		flock -x 9 || exit 1
		"$APP_FILE" stop && "$APP_FILE" start
	) 9>"$LOCK_FILE"
}

reload() {
	run_service reload "${1:-config}"
}

update_rules() {
	[ -n "$1" ] || return 1
	run_service update_rules "$1"
}
